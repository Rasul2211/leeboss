# PostgreSQL connection string (Neon, Supabase or a local server)
DATABASE_URL="postgresql://user:password@localhost:5432/leeboss?schema=public"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Telegram login widget. Create a bot with @BotFather, then bind your domain
# with /setdomain. The widget does not work on localhost.
TELEGRAM_BOT_NAME=""
TELEGRAM_BOT_TOKEN=""
